+    "native.tool_recovery": "recovery_rate",
+    "native.reliability": "score_mean",
+    "native.performance": "decode_tokens_per_second",
+    "native.token_economy": "quality_per_1k_output_tokens",
+    "native.memory_kv": "max_successful_context_tokens",
+    "native.energy": "output_tokens_per_joule",
+}
+"""The one figure that stands for each shipped suite in the heatmap.
+
+A heatmap needs one number per cell, and choosing it is an editorial act, so it is declared here
+rather than inferred: an inferred "first metric" would silently change when a suite gained one.
+A suite absent from this mapping still appears in the panels below — it just has no heatmap
+column, which is the honest outcome of nobody having decided what its headline is.
+
+Goal suites (``goal.<slug>``) resolve at runtime to ``goal_score``; see :func:`_headline_for`."""
+
+GOAL_HEADLINE_METRIC = "composite_score"
+"""The headline of any user-authored goal suite.
+
+Every goal installs under ``goal.<slug>`` and every one of them declares ``composite_score`` as
+its scored metric, so the heatmap resolves a goal column without a per-goal entry in
+:data:`HEADLINE_METRICS`. The goal's rubric is in the *suite version* — a different ``goal_hash``
+is a different version — so two rubrics never share a cell."""
+
+
+def _headline_for(suite_key: str) -> str | None:
+    """The headline metric of one suite, shipped or user-authored."""
+    if suite_key.startswith("goal."):
+        return GOAL_HEADLINE_METRIC
+    return HEADLINE_METRICS.get(suite_key)
+
+
+_PANELS: tuple[tuple[str, str, str, tuple[str, ...]], ...] = (
+    (
