+    finally:
+        engine.dispose()
+    goal = write_pack(goals_root, goal=_goal_body(), tasks=[_task_record()])
+    with Database.from_url(f"sqlite:///{database_path}") as database:
+        sync_goals(database, [goal])
+        add_samples(
