+    key: str
+    name: str
+    intent: str = ""
+    rung: str = "judge"
+    weight: float = 0.0
+    scale_points: int = 5
+    descriptors: Mapping[str, str] = field(default_factory=dict)
+    rule: Mapping[str, Any] | None = None
+    graded_alike: bool | None = None
+    one_quality: bool | None = None
+    split_from: str | None = None
