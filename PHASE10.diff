+)
+"""``(key, title, description, metric_keys)`` for every panel below the fold."""
+
+QUALITY_METRICS: tuple[str, ...] = (
+    "task_success",
+    "defect_detection_score",
+    "retrieval_accuracy",
+    "strict_prompt_accuracy",
+    "schema_conformance",
