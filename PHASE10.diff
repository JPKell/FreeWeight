+    try:
+        MigrationRunner(engine, script_location=MIGRATIONS_LOCATION).upgrade(backup=False)
+    finally:
+        engine.dispose()
+    handle = Database.from_url(url)
+    try:
+        yield handle
+    finally:
+        handle.close()
