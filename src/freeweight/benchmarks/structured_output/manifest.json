{
  "key": "native.structured_output",
  "name": "Structured Output",
  "version": "1.0.0",
  "category": "structured_output",
  "runner": "native",
  "headline_metric": "schema_conformance",
  "scorer": "json_schema",
  "capabilities": [
    "structured_output"
  ],
  "requires": {
    "provider_capabilities": [
      "structured_output"
    ],
    "sandbox": false,
    "network": false
  },
  "dataset_hashes": {},
  "prompt_ids": [
    {
      "prompt_id": "benchmarks.structured_output.schema",
      "version": "1.0.0",
      "sha256": "sha256:148126405e42aadb08bafe836863b04d9dd38e9239704e42b5f0b3c4fe0a1ea3"
    },
    {
      "prompt_id": "benchmarks.structured_output.repair",
      "version": "1.0.0",
      "sha256": "sha256:189ffa455a2fd19bd124c2eaf2cd00dfab77aa9026ed7e154d6adac02b38bae8"
    }
  ],
  "prompt_subset_hash": "sha256:70c83830a767b8054ba5004162c42d390d83e49b6b49abecbed62b329684ef89",
  "target_device": "any",
  "metrics": [
    {
      "metric_key": "valid_json",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Share of answers that parsed as JSON at all."
    },
    {
      "metric_key": "schema_conformance",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Share of answers that conformed to the case's schema with no violation."
    },
    {
      "metric_key": "required_field_presence",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Share of answers with every required field present."
    },
    {
      "metric_key": "type_correctness",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Share of answers whose top-level field types were all correct."
    },
    {
      "metric_key": "enum_adherence",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Share of answers whose enumerated fields used a declared value."
    },
    {
      "metric_key": "nesting_correctness",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Share of answers whose nested objects and arrays came out with the right shape."
    },
    {
      "metric_key": "first_attempt_conformed",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Share of cases that conformed without needing the corrective retry. Never replaced by the post-retry figure."
    },
    {
      "metric_key": "recovered_after_retry",
      "unit": "ratio",
      "higher_is_better": true,
      "aggregation": "mean",
      "description": "Of the cases that failed the first attempt, the share that conformed after one corrective retry."
    }
  ],
  "license": "project",
  "description": "JSON-mode and JSON-Schema conformance, checked by a bounded validator that refuses a schema keyword it does not decide rather than reporting conformance it never checked. Capability-gated: a provider without structured output records a skip, not a low score."
}
