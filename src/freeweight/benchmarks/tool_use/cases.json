{
  "tests": [
    {
      "key": "tool_use.selection",
      "name": "Choosing the right tool",
      "metric_keys": ["tool_selection_accuracy", "missed_tool_rate", "hallucinated_tool_rate", "unnecessary_call_rate", "multi_tool_sequence_accuracy", "task_success", "calls_per_success"],
      "cases": [
        {
          "case_id": "one-correct-tool",
          "scenario": "one_correct_tool",
          "required_context_tokens": 4096,
          "variables": {"task": "How many units of SKU A1 are in stock? Answer with the number alone."},
          "metadata": {"offered_tools": ["get_inventory", "calculator", "lookup_record"]},
          "expectation": {
            "tools": {"required_calls": [{"name": "get_inventory", "arguments": {"sku": "A1"}}]},
            "exact": {"any_of": ["12"], "contains": true}
          }
        },
        {
          "case_id": "several-similar-tools",
          "scenario": "several_similar_tools",
          "required_context_tokens": 4096,
          "variables": {"task": "What is the name of customer CUST-1002? Answer with the name alone."},
          "metadata": {"offered_tools": ["lookup_record", "database_query", "get_inventory", "search_text"]},
          "expectation": {
            "tools": {"required_calls": [{"name": "lookup_record", "arguments": {"record_id": "CUST-1002"}}]},
            "exact": {"any_of": ["Southgate Metals"], "contains": true}
          }
        },
        {
          "case_id": "no-tool-required",
          "scenario": "no_tool_required",
          "required_context_tokens": 4096,
          "variables": {"task": "How many days are there in a week? Answer with the number alone, without using any tool."},
          "metadata": {"offered_tools": ["get_inventory", "lookup_record", "calculator"]},
          "expectation": {
            "tools": {"required_calls": [], "no_tool_required": true},
            "exact": {"any_of": ["7", "seven"], "contains": true, "normalize": ["case"]}
          }
        },
        {
          "case_id": "tool-unavailable",
          "scenario": "tool_unavailable",
          "required_context_tokens": 4096,
          "variables": {"task": "Read the file pkg/pricing.py. If no tool can do that, say exactly UNAVAILABLE and nothing else."},
          "metadata": {"offered_tools": ["get_inventory", "calculator"]},
          "expectation": {
            "tools": {"required_calls": [], "no_tool_required": true, "forbidden_tools": ["read_file"]},
            "exact": {"any_of": ["UNAVAILABLE"], "contains": true}
          }
        }
      ]
    },
    {
      "key": "tool_use.arguments",
      "name": "Calling tools correctly",
      "metric_keys": ["argument_schema_validity", "argument_semantic_correctness", "tool_selection_accuracy", "repeated_identical_call_rate", "task_success"],
      "cases": [
        {
          "case_id": "argument-exact",
          "scenario": "argument_semantics",
          "required_context_tokens": 4096,
          "variables": {"task": "Where is the function restock_cost defined? Answer with the file path alone."},
          "metadata": {"offered_tools": ["search_symbol", "search_text", "read_file", "list_directory"]},
          "expectation": {
            "tools": {"required_calls": [{"name": "search_symbol", "arguments": {"symbol": "restock_cost"}}]},
            "exact": {"any_of": ["pkg/pricing.py"], "contains": true}
          }
        },
        {
          "case_id": "argument-invalid",
          "scenario": "invalid_argument",
          "required_context_tokens": 4096,
          "variables": {"task": "Compute 3 * (4 + 5) with the calculator and answer with the number alone."},
          "metadata": {"offered_tools": ["calculator"]},
          "expectation": {
            "tools": {"required_calls": [{"name": "calculator"}]},
            "exact": {"any_of": ["27"], "contains": true}
          }
        },
        {
          "case_id": "empty-result",
          "scenario": "empty_result",
          "required_context_tokens": 4096,
          "variables": {"task": "Find the literal text quantise in the repository. If nothing matches, say exactly NONE and nothing else."},
          "metadata": {"offered_tools": ["search_text", "search_symbol"]},
          "expectation": {
            "tools": {"required_calls": [{"name": "search_text", "arguments": {"query": "quantise"}}]},
            "exact": {"any_of": ["NONE"], "contains": true}
          }
        },
        {
          "case_id": "ambiguous-result",
          "scenario": "ambiguous_result",
          "required_context_tokens": 4096,
          "variables": {"task": "Which orders are for SKU B2? Answer with the order identifiers, separated by commas."},
          "metadata": {"offered_tools": ["database_query", "lookup_record"]},
          "expectation": {
            "tools": {"required_calls": [{"name": "database_query", "arguments": {"table": "orders", "field": "sku", "value": "B2"}}]},
            "exact": {"any_of": ["ORD-2, ORD-3", "ORD-2,ORD-3"], "contains": true}
          }
        }
      ]
    },
    {
      "key": "tool_use.sequences",
      "name": "Several tools in a row, and in parallel",
      "metric_keys": ["multi_tool_sequence_accuracy", "ordering_accuracy", "tool_selection_accuracy", "redundant_call_rate", "calls_per_success", "task_success"],
      "cases": [
        {
          "case_id": "sequential-tools",
          "scenario": "sequential_tools",
          "required_context_tokens": 8192,
          "variables": {"task": "Find where restock_cost is defined, then read that file, then answer with the name of the only function it imports."},
          "metadata": {"offered_tools": ["search_symbol", "read_file", "list_directory", "search_text"]},
          "expectation": {
            "tools": {
              "ordered": true,
              "required_calls": [
                {"name": "search_symbol", "arguments": {"symbol": "restock_cost"}},
                {"name": "read_file", "arguments": {"path": "pkg/pricing.py"}}
              ]
            },
            "exact": {"any_of": ["total_units"], "contains": true}
          }
        },
        {
          "case_id": "parallel-tools",
          "scenario": "parallel_independent_tools",
          "required_context_tokens": 8192,
          "variables": {"task": "Report the stock level of SKU A1 and the name of customer CUST-1001, separated by a comma."},
          "metadata": {"offered_tools": ["get_inventory", "lookup_record", "database_query"]},
          "expectation": {
            "tools": {
              "ordered": false,
              "required_calls": [
                {"name": "get_inventory", "arguments": {"sku": "A1"}},
                {"name": "lookup_record", "arguments": {"record_id": "CUST-1001"}}
              ]
            },
            "exact": {"any_of": ["12, Northwind Supply", "12,Northwind Supply"], "contains": true}
          }
        }
      ]
    },
    {
      "key": "tool_use.failure",
      "name": "A tool that fails",
      "metric_keys": ["task_success", "tool_selection_accuracy", "repeated_identical_call_rate", "redundant_call_rate"],
      "cases": [
        {
          "case_id": "tool-failure",
          "scenario": "tool_failure",
          "required_context_tokens": 8192,
          "variables": {"task": "How many units of SKU A1 are in stock? Answer with the number alone."},
          "metadata": {
            "offered_tools": ["get_inventory", "database_query"],
            "injected_failures": {"get_inventory": ["TIMEOUT"]}
          },
          "expectation": {
            "tools": {"required_calls": [{"name": "get_inventory", "arguments": {"sku": "A1"}}]},
            "exact": {"any_of": ["12"], "contains": true}
          }
        }
      ]
    }
  ]
}
